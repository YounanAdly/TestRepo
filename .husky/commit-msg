# Resolve node path dynamically — VS Code's embedded git doesn't inherit shell PATH or nvm
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" --no-use

# Fallback: common node locations (Homebrew, system, volta)
export PATH="$HOME/.volta/bin:$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node 2>/dev/null | tail -1)/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

npx --no-install commitlint --edit "$1"
