        "props": {
          "translate": true,
          "required": true,
          "placeholder": "createAccount.fields.civilId",
          "variant": "login",
          "type": "tel",
          "inputmode": "numeric",
          "maxLength": 7,
          "pattern": "^\\d{7}$",
          "prefixIconSrc": "assets/images/create-account-id-icon.svg",
          "containerClass": "input-label",
          "inputClass": "field-input",
          "iconClass": "field-icon"
        }
      }
    ]
  },
