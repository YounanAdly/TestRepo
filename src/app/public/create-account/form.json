[
  {
    "type": "section-header",
    "props": {
      "labelKey": "createAccount.sections.selectAccountType"
    }
  },
  {
    "key": "accountType",
    "type": "account-type-toggle",
    "defaultValue": "personal",
    "props": {
      "ariaLabel": "createAccount.accountType.ariaLabel",
      "options": [
        { "value": "personal", "labelKey": "createAccount.accountType.personal", "iconSrc": "assets/images/account-type-user.svg" },
        { "value": "organization", "labelKey": "createAccount.accountType.organization", "iconSrc": "assets/images/account-type-building.svg" }
      ]
    }
  },
  {
    "type": "section-header",
    "props": {
      "labelKey": "createAccount.sections.applicantDetails"
    }
  },
  {
    "fieldGroupClassName": "create-account-row create-account-row--two",
    "fieldGroup": [
      {
        "key": "firstName",
        "type": "custom-input",
        "className": "create-account-form-field create-account-col",
        "validators": {
          "validation": ["fullNamePattern"]
        },
        "props": {
          "translate": true,
          "required": true,
          "minLength": 2,
          "pattern": "^[A-Za-z\\u0600-\\u06FF\\s'.-]+$",
          "placeholder": "createAccount.fields.firstName",
          "variant": "login",
          "autocomplete": "given-name",
          "prefixIconSrc": "assets/images/create-account-name-icon.png",
          "containerClass": "input-label",
          "inputClass": "field-input",
          "iconClass": "field-icon"
        }
      },
      {
        "key": "lastName",
        "type": "custom-input",
        "className": "create-account-form-field create-account-col",
        "validators": {
          "validation": ["fullNamePattern"]
        },
        "props": {
          "translate": true,
          "required": true,
          "minLength": 2,
          "pattern": "^[A-Za-z\\u0600-\\u06FF\\s'.-]+$",
          "placeholder": "createAccount.fields.lastName",
          "variant": "login",
          "autocomplete": "family-name",
          "prefixIconSrc": "assets/images/create-account-name-icon.png",
          "containerClass": "input-label",
          "inputClass": "field-input",
          "iconClass": "field-icon"
        }
      }
    ]
  },
  {
    "fieldGroupClassName": "create-account-row create-account-row--single",
    "fieldGroup": [
      {
        "key": "civilId",
        "type": "custom-input",
        "className": "create-account-form-field create-account-col",
        "validators": {
          "validation": ["numbersOnly"]
